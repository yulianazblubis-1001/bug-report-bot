# ==========================================================================
# Bug Report Bot — environment variables
# --------------------------------------------------------------------------
# Copy this file to ".env" and fill in the blanks for local development.
# On Railway (or any host), set these same values in the dashboard instead
# of committing a .env file. NEVER commit a real .env — it holds secrets.
# ==========================================================================

# --- Server ---------------------------------------------------------------
# Port the server listens on. Railway sets this automatically; 5000 locally.
PORT=5000
NODE_ENV=development

# Public base URL of THIS app (used to build the credit-limit form links).
# Locally you can leave the default; in production set your Railway URL,
# e.g. https://bug-report-bot-production.up.railway.app
APP_URL=http://localhost:5000

# --- Database (Postgres) --------------------------------------------------
# Railway's Postgres plugin provides this automatically. For local dev,
# point it at a local or hosted Postgres instance.
DATABASE_URL=

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- WATI (WhatsApp) ------------------------------------------------------
WATI_API_ENDPOINT=
WATI_TOKEN=

# --- Slack ----------------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# Optional incoming-webhook fallbacks (only used if no bot token/channel)
SLACK_WEBHOOK_BUG=
SLACK_WEBHOOK_ADMIN=
# Channel IDs (these are not secret — pre-filled from the old config)
SLACK_CHANNEL_BUG=C085L46D50A
SLACK_CHANNEL_ADMIN=C0766PKUK1N
SLACK_CHANNEL_CREDIT_LIMIT=C0766PKUK1N
# Optional: a Slack user/group ID to @mention for ops (leave blank if unused)
SLACK_MENTION_OPS=

# --- Google (Sheets + Drive) ----------------------------------------------
# The full service-account JSON key. Paste it as one line (raw JSON), OR
# base64-encode the key file and paste that — both are accepted.
# See RAILWAY-DEPLOY.md for how to create this.
GOOGLE_SERVICE_ACCOUNT_KEY=
# IDs of the target Sheet and Drive folder (not secret — pre-filled)
GOOGLE_SHEETS_ID=1DC9XVBb8h-H-zVABrMOC1dHQ_CtFjyeUBptpc0ag9RM
GOOGLE_DRIVE_FOLDER_ID=1YkdwKz7O8pjVnouUVSVE_xzXFL9_6uKr

# --- Credit-limit form webhook -------------------------------------------
# Shared secret the Google Apps Script form sends in the x-webhook-secret
# header. Make up any long random string and use the same value in both places.
SHEET_WEBHOOK_SECRET=
